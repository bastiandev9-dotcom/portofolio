---
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { getCollection, render } from 'astro:content';
import type { Locale, Route } from '../i18n/index.ts';
import { t, LOCALES, hrefFor, ROUTE_LABEL } from '../i18n/index.ts';
import { profile, facts, stackGroups } from '../data/profile.ts';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  lang: Locale;
  path: Route;
}
const { lang, path } = Astro.props;
const dict = t(lang);

const entry = (await getCollection('about')).find((e) => e.data.locale === lang);
const { Content } = entry ? await render(entry) : { Content: undefined };
const detail = facts[lang];

const title =
  path === 'home' ? dict['meta.title'] : `${dict[ROUTE_LABEL[path]]} — ${dict['meta.title']}`;

const canonical = new URL(hrefFor(lang, path), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={dict['meta.description']} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(hrefFor(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(hrefFor('en', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dict['meta.description']} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict['meta.title']} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2f3f3" />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0e0f10' : '#f2f3f3');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{dict['a11y.skip']}</a>
    {path !== 'contact' && <Nav lang={lang} path={path} />}

    <main id="main">
      {path === 'home' && <Hero lang={lang} />}

      {
        (path === 'home' || path === 'about') && (
          <section id="about" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['about.label']}</h2>
              </div>

              <div class="about">
                <div class="bio reveal">
                  {Content && <Content />}
                </div>

                <dl class="reveal" style="--d: 80ms">
                  {detail.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </section>
        )
      }

      {path === 'home' && <Work lang={lang} variant="compact" />}
      {path === 'work' && <Work lang={lang} variant="full" />}

      {
        path === 'about' && (
          <section id="stack" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['stack.label']}</h2>
              </div>

              <div class="groups reveal">
                {stackGroups.map((group) => (
                  <div class="group">
                    <h3 class="label">{group.label}</h3>
                    <ul>
                      {group.items.map((item) => (
                        <li class="mono">{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <p class="note mono reveal">{dict['stack.note']}</p>
            </div>
          </section>
        )
      }

      {
        path === 'contact' && (
          <div class="touch">
            <div class="container">
              <div class="tools">
                <ThemeToggle lang={lang} />
              </div>

              <div class="grid">
              <header class="who reveal">
                <p class="wordmark">{profile.name}<span>.</span></p>
                <p class="about">{dict['contact.note']}</p>
                <p class="fact">{dict['hero.location']}</p>
                <p class="fact">
                  <a href={`mailto:${profile.email}`}>{profile.email}</a>
                </p>
              </header>

              <nav class="col pages reveal" style="--d: 60ms" aria-label={dict['contact.pages']}>
                <p class="label">{dict['contact.pages']}</p>
                <ul>
                  <li><a href={hrefFor(lang, 'home')}>{dict['nav.home']}</a></li>
                  <li><a href={hrefFor(lang, 'work')}>{dict['nav.work']}</a></li>
                  <li><a href={hrefFor(lang, 'about')}>{dict['nav.about']}</a></li>
                  <li><a href={hrefFor(lang, 'contact')}>{dict['nav.contact']}</a></li>
                </ul>
              </nav>

              <nav class="col social reveal" style="--d: 120ms" aria-label={dict['contact.social']}>
                <p class="label">{dict['contact.social']}</p>
                <ul>
                  <li>
                    <a href={profile.links.github} target="_blank" rel="noopener noreferrer">
                      GitHub ↗
                    </a>
                  </li>
                  <li>
                    <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
                      LinkedIn ↗
                    </a>
                  </li>
                  <li>
                    <a href={profile.links.instagram} target="_blank" rel="noopener noreferrer">
                      Instagram ↗
                    </a>
                  </li>
                </ul>
              </nav>

              <p class="mail reveal" style="--d: 120ms">
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </p>

              <form
                id="touch"
                method="post"
                action="/api/contact/"
                class="card reveal"
                style="--d: 180ms"
                data-sending={dict['contact.sending']}
                data-sent={dict['contact.sent']}
                data-failed={dict['contact.failed']}
              >
                <h2>{dict['contact.card']}</h2>
                <p class="intro">{dict['contact.heading']}</p>

                <div class="hp">
                  <label for="f-website">{dict['contact.hp']}</label>
                  <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <div class="field">
                  <label for="f-first">{dict['contact.field.first']}</label>
                  <input id="f-first" name="first" type="text" autocomplete="given-name" required />
                </div>

                <div class="field">
                  <label for="f-last">{dict['contact.field.last']}</label>
                  <input id="f-last" name="last" type="text" autocomplete="family-name" required />
                </div>

                <div class="field">
                  <label for="f-email">{dict['contact.field.email']}</label>
                  <input id="f-email" name="email" type="email" autocomplete="email" required />
                </div>

                <div class="field">
                  <label for="f-msg">{dict['contact.field.message']}</label>
                  <textarea id="f-msg" name="message" rows="3" required></textarea>
                </div>

                <button class="send" type="submit">
                  <span>{dict['contact.send']}</span>
                  <span aria-hidden="true">→</span>
                </button>
                <p class="status" role="status" aria-live="polite"></p>
              </form>

              <p class="copy mono reveal">
                © {new Date().getFullYear()} {profile.name} — {dict['hero.location']}
              </p>
              </div>
            </div>
          </div>
        )
      }
    </main>

    {path !== 'contact' && <Footer lang={lang} />}

    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        // Anything already on screen shows at once — no flash of hidden text.
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('is-visible');
          } else {
            io.observe(el);
          }
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const form = document.getElementById('touch');
        if (!form) return;

        const status = form.querySelector('.status');
        const btn = form.querySelector('.send');
        const label = btn.querySelector('span');
        const idle = label.textContent;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          btn.disabled = true;
          label.textContent = form.dataset.sending;
          status.textContent = '';
          status.dataset.state = '';

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(Object.fromEntries(new FormData(form))),
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok && data.ok) {
              form.reset();
              status.textContent = form.dataset.sent;
              status.dataset.state = 'ok';
            } else {
              status.textContent = form.dataset.failed;
              status.dataset.state = 'bad';
            }
          } catch {
            status.textContent = form.dataset.failed;
            status.dataset.state = 'bad';
          } finally {
            btn.disabled = false;
            label.textContent = idle;
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .bio {
    max-width: 62ch;
    display: grid;
    gap: 16px;
  }

  .bio :global(p) {
    opacity: 0.84;
  }

  dl {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  dl > div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
  }

  .group h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 12px;
  }

  .group ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .group li {
    color: var(--ink);
    opacity: 0.8;
  }

  .note {
    color: var(--muted);
    margin-top: 40px;
  }

/* ---------- contact (self-contained page: no Nav, no Footer) ---------- */

  .touch {
    padding-block: clamp(48px, 8vh, 96px) var(--section-y);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .touch .container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 36px;
  }

  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 0.9fr 1.25fr;
    grid-template-areas:
      'who pages social mail'
      'who pages social card'
      'copy copy copy copy';
    column-gap: 40px;
    align-content: start;
  }

  .who {
    grid-area: who;
  }

  .pages {
    grid-area: pages;
  }

  .social {
    grid-area: social;
  }

  .wordmark {
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: var(--leading-tight);
  }

  .wordmark span {
    color: var(--accent);
  }

  .about {
    margin-top: 26px;
    max-width: 36ch;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    opacity: 0.78;
  }

  .fact {
    margin-top: 14px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .fact a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .col .label {
    margin-bottom: 16px;
  }

  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .col a {
    font-size: var(--text-sm);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .col a:hover {
    color: var(--ink);
  }

  .mail {
    grid-area: mail;
    align-self: start;
  }

  .mail a {
    display: inline-block;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    transition: color var(--dur-fast) var(--ease);
  }

  .mail a:hover {
    color: var(--accent);
  }

  .card {
    grid-area: card;
    align-self: start;
    margin-top: 44px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 26px;
  }

  .card h2 {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .intro {
    margin: 14px 0 34px;
    max-width: 42ch;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Honeypot — off-screen, not display:none, so bots still fill it. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field {
    margin-bottom: 22px;
  }

  .field label {
    display: block;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 8px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .field textarea {
    min-height: 68px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-bottom-color: var(--accent);
  }

  .send {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 13px 22px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .send:hover {
    background: var(--accent);
    color: var(--surface);
  }

  .send:disabled {
    cursor: progress;
    opacity: 0.6;
  }

  .status {
    min-height: 1.2em;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--muted);
  }

  .status[data-state='ok'] {
    color: var(--accent);
  }

  .copy {
    grid-area: copy;
    align-self: end;
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'who mail'
        'pages social'
        'card card'
        'copy copy';
      row-gap: 44px;
    }

    .card {
      margin-top: 0;
      max-width: 640px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'who'
        'mail'
        'pages'
        'social'
        'card'
        'copy';
      row-gap: 36px;
    }

    .card {
      padding: 24px;
      border-radius: 20px;
    }

    .copy {
      margin-top: 40px;
    }
  }
</style>