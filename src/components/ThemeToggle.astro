---
import type { Locale } from '../i18n/index.ts';
import { t } from '../i18n/index.ts';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const dict = t(lang);
---

<button type="button" id="theme-toggle" aria-label={dict['a11y.theme']}>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <g class="sun">
      <circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.2"></circle>
      <path
        d="M8 0.75v1.6M8 13.65v1.6M15.25 8h-1.6M2.35 8h-1.6M13.09 2.91l-1.13 1.13M4.04 11.96l-1.13 1.13M13.09 13.09l-1.13-1.13M4.04 4.04L2.91 2.91"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"></path>
    </g>
    <path
      class="moon"
      d="M13.5 9.6A5.9 5.9 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  button:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .moon {
    display: none;
  }

  :global(html[data-theme='dark']) .sun {
    display: none;
  }

  :global(html[data-theme='dark']) .moon {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  })();
</script>