---
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { getCollection, render } from 'astro:content';
import type { Locale, Route } from '../i18n/index.ts';
import { t, LOCALES, hrefFor, ROUTE_LABEL } from '../i18n/index.ts';
import { profile, facts, stackGroups } from '../data/profile.ts';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Locale;
  path: Route;
}
const { lang, path } = Astro.props;
const dict = t(lang);

const entry = (await getCollection('about')).find((e) => e.data.locale === lang);
const { Content } = entry ? await render(entry) : { Content: undefined };
const detail = facts[lang];

const title =
  path === 'home' ? dict['meta.title'] : `${dict[ROUTE_LABEL[path]]} — ${dict['meta.title']}`;

const canonical = new URL(hrefFor(lang, path), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={dict['meta.description']} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(hrefFor(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(hrefFor('en', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dict['meta.description']} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict['meta.title']} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2f3f3" />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0e0f10' : '#f2f3f3');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{dict['a11y.skip']}</a>
    <Nav lang={lang} path={path} />

    <main id="main">
      {path === 'home' && <Hero lang={lang} />}
      {path === 'home' && <Work lang={lang} variant="compact" />}
      {path === 'work' && <Work lang={lang} variant="full" />}

      {
        (path === 'home' || path === 'about') && (
          <section id="about" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['about.label']}</h2>
              </div>

              <div class="about">
                <div class="bio reveal">
                  {Content && <Content />}
                </div>

                <dl class="reveal" style="--d: 80ms">
                  {detail.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </section>
        )
      }

      {
        path === 'about' && (
          <section id="stack" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['stack.label']}</h2>
              </div>

              <div class="groups reveal">
                {stackGroups.map((group) => (
                  <div class="group">
                    <h3 class="label">{group.label}</h3>
                    <ul>
                      {group.items.map((item) => (
                        <li class="mono">{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <p class="note mono reveal">{dict['stack.note']}</p>
            </div>
          </section>
        )
      }

      {
        (path === 'home' || path === 'contact') && (
          <section id="contact" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['contact.label']}</h2>
              </div>

              <p class="heading reveal">{dict['contact.heading']}</p>

              <a class="email reveal" style="--d: 60ms" href={`mailto:${profile.email}`}>
                {profile.email}
              </a>

              <ul class="elsewhere reveal" style="--d: 120ms">
                <li>
                  <a href={profile.links.github} target="_blank" rel="noopener noreferrer">
                    GitHub ↗
                  </a>
                </li>
                <li>
                  <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
                    LinkedIn ↗
                  </a>
                </li>
                <li>
                  <a href={profile.links.instagram} target="_blank" rel="noopener noreferrer">
                    Instagram ↗
                  </a>
                </li>
              </ul>
            </div>
          </section>
        )
      }
    </main>

    <Footer lang={lang} />

    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        // Anything already on screen shows at once — no flash of hidden text.
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('is-visible');
          } else {
            io.observe(el);
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .bio {
    max-width: 62ch;
    display: grid;
    gap: 16px;
  }

  .bio :global(p) {
    opacity: 0.84;
  }

  dl {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  dl > div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
  }

  .group h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 12px;
  }

  .group ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .group li {
    color: var(--ink);
    opacity: 0.8;
  }

  .note {
    color: var(--muted);
    margin-top: 40px;
  }

  .heading {
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
    margin-bottom: 32px;
  }

  .email {
    display: inline-block;
    font-size: clamp(1.5rem, 4.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 4px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .elsewhere {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin-top: 32px;
  }

  .elsewhere a {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .elsewhere a:hover {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>