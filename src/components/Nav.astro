---
import type { Locale } from '../i18n/index.ts';
import { t, otherLang, hrefFor } from '../i18n/index.ts';
import { profile } from '../data/profile.ts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const dict = t(lang);
const alt = otherLang(lang);
const links = [
  { href: '/#work', label: dict['nav.work'] },
  { href: '/#about', label: dict['nav.about'] },
  { href: '/#stack', label: dict['nav.stack'] },
  { href: '/#contact', label: dict['nav.contact'] },
];
---

<header>
  <div class="container bar">
    <a class="brand" href={hrefFor(lang)}>
      <span class="mono">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controls">
      <a class="lang" href={hrefFor(alt)} lang={alt} hreflang={alt} aria-label={dict['a11y.lang']}>
        {alt.toUpperCase()}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .brand {
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    padding: 0;
  }

  nav a {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  nav a:hover {
    color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .lang:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
</style>