---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/index.ts';
import { t } from '../i18n/index.ts';
import { profile, archiveRepos } from '../data/profile.ts';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const dict = t(lang);

const shots = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>(
      '../assets/projects/sawmoto/*.{png,jpg,jpeg,webp}',
      { eager: true },
    ),
  ).map(([path, mod]) => [path.split('/').pop()?.replace(/\.\w+$/, '') ?? '', mod.default]),
);

const items = (await getCollection('projects'))
  .filter((p) => p.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    d: p.data,
    paragraphs: (p.body ?? '')
      .split('\n\n')
      .map((s) => s.trim())
      .filter(Boolean),
    shots: p.data.images.map((name) => shots[name]).filter(Boolean),
  }));

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="work" class="section">
  <div class="container">
    <div class="section__head reveal">
      <h2 class="label">{dict['work.label']}</h2>
      <span class="count">({pad(items.length)})</span>
    </div>

    {
      items.map((item, index) => (
        <article class="project reveal" style={`--d: ${index * 70}ms`}>
          <div class="row">
            <span class="num mono">{pad(item.d.order)}</span>

            <div class="body">
              <div class="titlebar">
                <h3>{item.d.title}</h3>
                {item.d.team && <span class="tag mono">{dict['work.team']}</span>}
                {item.shots.length > 0 && <span class="arrow" aria-hidden="true">→</span>}
              </div>

              <p class="meta mono">
                {item.d.stack.join('  ·  ')}  ·  {item.d.year}
              </p>

              <div class="prose">
                {item.paragraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </div>

              <div class="links">
                {item.d.live && (
                  <a href={item.d.live} target="_blank" rel="noopener noreferrer">
                    {dict['work.live']} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <a href={item.d.repo} target="_blank" rel="noopener noreferrer">
                  {dict['work.repo']} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>

          {item.shots.length > 0 && (
            <div class="gallery">
              {item.shots.map((img, i) => (
                <figure>
                  <Image
                    src={img}
                    alt={`${item.d.title} — ${item.d.captions[i] ?? ''}`}
                    widths={[480, 720, 1080]}
                    sizes={
                      i === 0
                        ? '(max-width: 720px) 92vw, 1016px'
                        : '(max-width: 720px) 92vw, 328px'
                    }
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <figcaption class="mono">
                    {pad(i + 1)} · {item.d.captions[i]}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </article>
      ))
    }

    <aside class="archive reveal">
      <p class="label">{dict['work.archive']}</p>
      <p class="mono">
        {archiveRepos.join('  ·  ')}
        <a class="gh" href={profile.links.github} target="_blank" rel="noopener noreferrer">
          {dict['work.more']} <span aria-hidden="true">↗</span>
        </a>
      </p>
    </aside>
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 8px;
  }

  .project {
    padding-block: 40px;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
  }

  .num {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }

  .titlebar {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .tag {
    color: var(--accent);
    border: 1px solid var(--line);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .meta {
    color: var(--muted);
    margin-bottom: 20px;
  }

  .prose {
    max-width: 68ch;
    display: grid;
    gap: 14px;
  }

  .prose p {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    opacity: 0.82;
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }

  .links a,
  .gh {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .links a:hover,
  .gh:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 36px;
  }

  figure {
    margin: 0;
  }

  /* First shot carries the weight: full width, then three below. */
  figure:first-child {
    grid-column: 1 / -1;
  }

  /* The screenshots are dark; a hairline keeps them a distinct object
     on both the light and the dark theme. */
  figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  figcaption {
    color: var(--muted);
    margin-top: 8px;
  }

  .archive {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding-block: 40px 8px;
  }

  .archive p {
    max-width: 78ch;
    line-height: 2;
  }

  .gh {
    display: inline-block;
    margin-left: 8px;
  }

  @media (max-width: 720px) {
    .row,
    .archive {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .num {
      padding-top: 0;
    }

    .gallery {
      grid-template-columns: 1fr;
    }

    .archive {
      padding-block: 32px 8px;
    }
  }
</style>