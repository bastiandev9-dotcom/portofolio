---
import type { Locale, Route } from '../i18n/index.ts';
import { t, otherLang, hrefFor } from '../i18n/index.ts';
import { profile } from '../data/profile.ts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
  path: Route;
}
const { lang, path } = Astro.props;
const dict = t(lang);
const alt = otherLang(lang);

const nav = (['work', 'about', 'contact'] as const).map((route) => ({
  route,
  href: hrefFor(lang, route),
  label: dict[`nav.${route}`],
  current: path === route,
}));
---

<header>
  <div class="container bar">
    <a class="brand mono" href={hrefFor(lang, 'home')} aria-label={profile.name}>
      <span class="long">{profile.name}</span>
      <span class="short">{profile.monogram}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controls">
      <a
        class="lang mono"
        href={hrefFor(alt, path)}
        lang={alt}
        hreflang={alt}
        aria-label={dict['a11y.lang']}>{alt.toUpperCase()}</a
      >
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
  }

  .brand {
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* The nav is the only way to reach other pages now, so it must survive
     small screens — the long name is what gives way, not the links. */
  .short {
    display: none;
  }

  @media (max-width: 640px) {
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    ul {
      gap: 14px;
    }

    .bar {
      gap: 12px;
    }
  }

  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    padding: 0;
  }

  nav a {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  nav a:hover {
    color: var(--ink);
  }

  /* Current page carries the weight — no background pill, just ink. */
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .lang:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
</style>