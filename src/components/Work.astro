---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/index.ts';
import { t, hrefFor } from '../i18n/index.ts';
import { profile, archiveRepos } from '../data/profile.ts';

interface Props {
  lang: Locale;
  /** compact = shortlist on the home page, full = the work page */
  variant?: 'compact' | 'full';
}
const { lang, variant = 'full' } = Astro.props;
const dict = t(lang);
const compact = variant === 'compact';

const items = (await getCollection('projects'))
  .filter((p) => p.data.locale === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    d: p.data,
    paragraphs: (p.body ?? '')
      .split('\n\n')
      .map((s) => s.trim())
      .filter(Boolean),
  }));

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="work" class:list={['section', { compact }]}>
  <div class="container">
    <div class="section__head reveal">
      <h2 class="label">{dict['work.label']}</h2>
      {
        compact ? (
          <a class="all mono" href={hrefFor(lang, 'work')}>
            {dict['work.all']} ({pad(items.length)})
          </a>
        ) : (
          <span class="count">
            ({pad(items.length)})
          </span>
        )
      }
    </div>

    {
      items.map((item, index) => (
        <article class="project reveal" style={`--d: ${index * 70}ms`}>
          <div class="row">
            <span class="num mono">{pad(item.d.order)}</span>

            <div class="body">
              <div class="titlebar">
                <div class="named">
                  <h3>{item.d.title}</h3>
                  {item.d.team && <span class="tag mono">{dict['work.team']}</span>}
                </div>
                <p class="meta mono">
                  {item.d.stack.join(' · ')} · {item.d.year}
                </p>
              </div>

              {!compact && (
                <div class="prose">
                  {item.paragraphs.map((para) => (
                    <p>{para}</p>
                  ))}
                </div>
              )}

              <div class="links">
                {item.d.live && (
                  <a href={item.d.live} target="_blank" rel="noopener noreferrer">
                    {dict['work.live']} <span aria-hidden="true">↗</span>
                  </a>
                )}
                <a href={item.d.repo} target="_blank" rel="noopener noreferrer">
                  {dict['work.repo']} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))
    }

    {
      !compact && (
        <aside class="archive reveal">
          <p class="label">{dict['work.archive']}</p>
          <p class="mono">
            {archiveRepos.join(' · ')}
            <a class="gh" href={profile.links.github} target="_blank" rel="noopener noreferrer">
              {dict['work.more']} <span aria-hidden="true">↗</span>
            </a>
          </p>
        </aside>
      )
    }
  </div>
</section>

<style>
  .section__head {
    margin-bottom: 8px;
  }

  .all {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .all:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project {
    padding-block: 36px;
    border-bottom: 1px solid var(--line);
  }

  .compact .project {
    padding-block: 26px;
  }

  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
  }

  .num {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 6px;
  }

  .titlebar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }

  .compact .titlebar {
    margin-bottom: 12px;
  }

  .named {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .tag {
    color: var(--accent);
    border: 1px solid var(--line);
    padding: 3px 8px;
    white-space: nowrap;
  }

  .meta {
    color: var(--muted);
    text-align: right;
    flex-shrink: 0;
  }

  .prose {
    max-width: 68ch;
    display: grid;
    gap: 14px;
  }

  .prose p {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    opacity: 0.82;
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 18px;
  }

  .compact .links {
    margin-top: 10px;
  }

  .links a,
  .gh {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .links a:hover,
  .gh:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .archive {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding-block: 36px 8px;
  }

  .archive p {
    max-width: 78ch;
    line-height: 2;
  }

  .gh {
    display: inline-block;
    margin-left: 8px;
  }

  @media (max-width: 720px) {
    .row,
    .archive {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .num {
      padding-top: 0;
    }

    .titlebar {
      flex-direction: column;
      gap: 6px;
    }

    .meta {
      text-align: left;
    }
  }
</style>