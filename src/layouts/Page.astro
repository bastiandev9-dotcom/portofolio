---
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { getCollection, render } from 'astro:content';
import type { Locale, Route } from '../i18n/index.ts';
import { t, LOCALES, hrefFor, ROUTE_LABEL } from '../i18n/index.ts';
import { profile, facts, stackGroups } from '../data/profile.ts';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Locale;
  path: Route;
}
const { lang, path } = Astro.props;
const dict = t(lang);

const entry = (await getCollection('about')).find((e) => e.data.locale === lang);
const { Content } = entry ? await render(entry) : { Content: undefined };
const detail = facts[lang];

const title =
  path === 'home' ? dict['meta.title'] : `${dict[ROUTE_LABEL[path]]} — ${dict['meta.title']}`;

const canonical = new URL(hrefFor(lang, path), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={dict['meta.description']} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(hrefFor(l, path), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(hrefFor('en', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dict['meta.description']} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict['meta.title']} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2f3f3" />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0e0f10' : '#f2f3f3');
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{dict['a11y.skip']}</a>
    <Nav lang={lang} path={path} />

    <main id="main">
      {path === 'home' && <Hero lang={lang} />}

      {
        (path === 'home' || path === 'about') && (
          <section id="about" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['about.label']}</h2>
              </div>

              <div class="about">
                <div class="bio reveal">
                  {Content && <Content />}
                </div>

                <dl class="reveal" style="--d: 80ms">
                  {detail.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </section>
        )
      }

      {path === 'home' && <Work lang={lang} variant="compact" />}
      {path === 'work' && <Work lang={lang} variant="full" />}

      {
        path === 'about' && (
          <section id="stack" class="section">
            <div class="container">
              <div class="section__head reveal">
                <h2 class="label">{dict['stack.label']}</h2>
              </div>

              <div class="groups reveal">
                {stackGroups.map((group) => (
                  <div class="group">
                    <h3 class="label">{group.label}</h3>
                    <ul>
                      {group.items.map((item) => (
                        <li class="mono">{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <p class="note mono reveal">{dict['stack.note']}</p>
            </div>
          </section>
        )
      }

      {
path === 'contact' && (
          <div class="touch">
            <div class="container">
              <div class="grid">
                <section class="intro reveal">
                  <p class="badge"><i aria-hidden="true"></i>{profile.status[lang]}</p>

                  <h1>
                    {dict['contact.headline.a']}<br />{dict['contact.headline.b']}<span>.</span>
                  </h1>

                  <p class="lead">{dict['contact.note']}</p>

                  <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>

                  <div class="socials">
                    <h2 class="label">{dict['contact.elsewhere']}</h2>
                    <a href={profile.links.github} target="_blank" rel="noopener noreferrer">
                      <span>GitHub</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                    <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
                      <span>LinkedIn</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                    <a href={profile.links.instagram} target="_blank" rel="noopener noreferrer">
                      <span>Instagram</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </section>

                <section class="card reveal" style="--d: 80ms">
                  <div>
                    <h2>{dict['contact.form.title']}</h2>
                    <p>{dict['contact.form.note']}</p>
                  </div>

                  <form
                    id="touch"
                    class="form"
                    method="post"
                    action="/api/contact/"
                    data-sending={dict['contact.sending']}
                    data-sent={dict['contact.sent']}
                    data-failed={dict['contact.failed']}
                  >
                    <div class="hp">
                      <label for="f-website">{dict['contact.hp']}</label>
                      <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="two">
                      <div>
                        <label for="f-first">{dict['contact.field.first']}</label>
                        <input id="f-first" name="first" type="text" autocomplete="given-name" required />
                      </div>
                      <div>
                        <label for="f-last">{dict['contact.field.last']}</label>
                        <input id="f-last" name="last" type="text" autocomplete="family-name" />
                      </div>
                    </div>

                    <div>
                      <label for="f-email">{dict['contact.field.email']}</label>
                      <input id="f-email" name="email" type="email" autocomplete="email" required />
                    </div>

                    <div>
                      <label for="f-msg">{dict['contact.field.message']}</label>
                      <textarea id="f-msg" name="message" rows="4" required></textarea>
                    </div>

                    <button class="send" type="submit">
                      {dict['contact.send']}
                      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M13 6l6 6-6 6"></path>
                      </svg>
                    </button>
                    <p class="status" role="status" aria-live="polite"></p>
                  </form>
                </section>
              </div>

              <div class="foot mono">
                <span>{dict['hero.location']}</span>
                <span>© {new Date().getFullYear()} {profile.name}</span>
              </div>
            </div>
          </div>
        )
      }
    </main>

    {path !== 'contact' && <Footer lang={lang} />}

    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        // Anything already on screen shows at once — no flash of hidden text.
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('is-visible');
          } else {
            io.observe(el);
          }
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const form = document.getElementById('touch');
        if (!form) return;

        const status = form.querySelector('.status');
        const btn = form.querySelector('.send');
        const label = btn.querySelector('span');
        const idle = label.textContent;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          btn.disabled = true;
          label.textContent = form.dataset.sending;
          status.textContent = '';
          status.dataset.state = '';

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(Object.fromEntries(new FormData(form))),
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok && data.ok) {
              form.reset();
              status.textContent = form.dataset.sent;
              status.dataset.state = 'ok';
            } else {
              status.textContent = form.dataset.failed;
              status.dataset.state = 'bad';
            }
          } catch {
            status.textContent = form.dataset.failed;
            status.dataset.state = 'bad';
          } finally {
            btn.disabled = false;
            label.textContent = idle;
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .bio {
    max-width: 62ch;
    display: grid;
    gap: 16px;
  }

  .bio :global(p) {
    opacity: 0.84;
  }

  dl {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  dl > div {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
  }

  .group h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 12px;
  }

  .group ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .group li {
    color: var(--ink);
    opacity: 0.8;
  }

  .note {
    color: var(--muted);
    margin-top: 40px;
  }

/* ---------- contact (Nav stays, shared Footer does not) ---------- */

  .touch {
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
  }

  .touch .container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 64px;
    padding-block: clamp(40px, 6vh, 72px);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .badge i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .intro h1 {
    font-size: var(--text-display);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .intro h1 span {
    color: var(--accent);
  }

  .lead {
    max-width: 460px;
    color: var(--muted);
    font-size: var(--text-base);
  }

  .email {
    align-self: flex-start;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-strong);
    font-size: clamp(1.5rem, 4.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .socials {
    display: flex;
    flex-direction: column;
  }

  .socials h2 {
    padding-bottom: 14px;
  }

  .socials a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    font-size: var(--text-base);
    transition: color var(--dur-fast) var(--ease), padding-left var(--dur-fast) var(--ease);
  }

  .socials a:last-child {
    border-bottom: 1px solid var(--line);
  }

  .socials a:hover {
    color: var(--accent);
    padding-left: 8px;
  }

  .card {
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(28px, 3.5vw, 48px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 24px;
  }

  .card h2 {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .card p {
    margin-top: 8px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }

  /* Honeypot — off-screen rather than display:none, so bots still fill it. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  label {
    display: block;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 10px 0 12px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    resize: vertical;
    transition: border-color var(--dur-fast) var(--ease);
  }

  input:focus-visible,
  textarea:focus-visible {
    border-bottom-color: var(--accent);
  }

  .send {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding-inline: 28px;
    background: var(--accent);
    color: var(--bg);
    border: 0;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: transform 150ms var(--ease);
  }

  .send:hover {
    transform: translateY(-2px);
  }

  .send:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .status {
    min-height: 1.2em;
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--muted);
  }

  .status[data-state='ok'] {
    color: var(--accent);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .grid {
      gap: 48px;
    }

    .card {
      padding: 28px 22px;
    }
  }
</style>
